<Window x:Class="WeatherPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WeatherPet"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Label x:Name="weatherLabel" FontSize="20" Margin="20"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Label Content="Введите город" Margin="80,20,0,20" />
        <TextBox Width="200" Height="25" VerticalAlignment="Top" Margin="0,20,20,20" HorizontalAlignment="Right" x:Name="ChooseCity"/>
        </StackPanel>
        <Button Grid.Column="1" Width="200" Height="25" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="20" x:Name="Confirm" Click="Confirm_Click" Content="Проверить погоду"/>
    </Grid>
</Window>
